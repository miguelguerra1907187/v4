# ------------------------------------------------------------------ archivos
def leer_json(path, defecto=None):
    try:
        with open(path, encoding='utf-8') as f:
            return json.load(f)
    except (OSError, ValueError):
        return defecto


def escribir_json(path, data):
    tmp = os.path.join(os.path.dirname(path), '.' + os.path.basename(path) + '.tmp')
    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump(data, f, ensure_ascii=False, separators=(',', ':'))
    os.replace(tmp, path)


def anotar_error(donde, e):
    """Guarda el error en mm_caja_errores.log (en Pythonista) para poder revisarlo."""
    try:
        os.makedirs(DOCS, exist_ok=True)
        with open(F_ERRORES, 'a', encoding='utf-8') as f:
            f.write('%s  %s: %s\n' % (dt.datetime.now().isoformat(timespec='seconds'), donde, e))
    except OSError:
        pass


def errores_recientes(n=5):
    try:
        with open(F_ERRORES, encoding='utf-8') as f:
            lineas = f.read().strip().splitlines()
    except OSError:
        return []
    hoy_ = dt.date.today().isoformat()
    desde = (leer_json(F_VERSION, {}) or {}).get('desde', '')
    return [l for l in lineas[-n:] if l.startswith(hoy_) and l[:19] >= desde]


def este_celular():
    os.makedirs(DOCS, exist_ok=True)
    d = leer_json(F_LOCAL, None)
    if not d or not d.get('id'):
        d = {'quien': '', 'id': ''.join(random.choice(string.ascii_lowercase + string.digits) for _ in range(6))}
        escribir_json(F_LOCAL, d)
    return d


def carpeta():
    """(ruta, compartida?) — la carpeta compartida si está vinculada y se puede escribir."""
    ruta = ''
    try:
        ruta = open(F_CARPETA, encoding='utf-8').read().strip()
    except OSError:
        pass
    if ruta and os.path.isdir(ruta) and os.access(ruta, os.W_OK):
        return ruta, True
    return BASE, False


def pedir_descarga(path):
    """Pide a iCloud que baje (o actualice) un archivo de la carpeta compartida."""
    try:
        from objc_util import ObjCClass, nsurl
        ObjCClass('NSFileManager').defaultManager().startDownloadingUbiquitousItemAtURL_error_(nsurl(path), None)
    except Exception:
        pass


# ------------------------------------------------------------------ juntar datos
def orden(r):
    return (r.get('cre') or 0, r.get('fecha') or '', r.get('hora') or '', r.get('id') or '')


def mezclar(a, b):
    """Junta dos estados. Por registro gana el de 'upd' más reciente."""
    ca, cb = (a or {}).get('conf') or {}, (b or {}).get('conf') or {}
    conf = dict(cb if cb.get('upd', 0) > ca.get('upd', 0) else ca)
    db = {}
    for k in COLS:
        m = {}
        for r in ((a or {}).get('db') or {}).get(k, []) + ((b or {}).get('db') or {}).get(k, []):
            rid = r.get('id')
            x = m.get(rid)
            if x is None or r.get('upd', 0) > x.get('upd', 0):
                m[rid] = r
        db[k] = sorted(m.values(), key=orden)
    return {'conf': conf, 'db': db}


def archivo_propio(ruta):
    return os.path.join(ruta, 'datos_%s.json' % este_celular()['id'])


def estado_actual():
    """Lee y junta los archivos de todos los celulares. Regresa (estado, otros)."""
    ruta, compartida = carpeta()
    propio = archivo_propio(ruta)
    estado = {'conf': dict(CONF_INICIAL), 'db': {k: [] for k in COLS}}
    otros = []
    AVISOS[:] = []
    try:
        nombres = os.listdir(ruta)
    except OSError as e:
        nombres = []
        AVISOS.append({'n': 'rojo', 't': 'No puedo leer la carpeta de datos', 'd': str(e)})
    for n in nombres:
        nube = PATRON_NUBE.match(n)
        if nube:
            pedir_descarga(os.path.join(ruta, nube.group(1)))
            AVISOS.append({'n': 'amar', 't': 'iCloud todavía está bajando datos del otro celular',
                           'd': 'Archivo %s. Espera un momento con internet; se actualiza solo.' % nube.group(1)})
            continue
        if not PATRON.match(n):
            continue
        if PATRON_CONFLICTO.match(n):
            AVISOS.append({'n': 'info', 't': 'iCloud creó una copia por conflicto',
                           'd': '%s ya se juntó con lo demás; no se pierde nada. Puedes borrarla desde Archivos.' % n})
        path = os.path.join(ruta, n)
        if path != propio:
            pedir_descarga(path)
        d = leer_json(path)
        if not isinstance(d, dict):
            AVISOS.append({'n': 'rojo', 't': 'No pude leer %s' % n,
                           'd': 'Puede que iCloud lo esté subiendo a medias. Si sigue así varios minutos, avísame.'})
            continue
        estado = mezclar(estado, d)
        meta = d.get('meta') or {}
        if path != propio and meta.get('quien') and not PATRON_CONFLICTO.match(n):
            hora = (meta.get('guardado') or '')[11:16]
            dia = (meta.get('guardado') or '')[:10]
            otros.append({'quien': meta['quien'], 'hora': hora if dia == dt.date.today().isoformat() else dia,
                          'guardado': meta.get('guardado') or ''})
    return estado, otros, ruta, compartida


def guardar_propio(estado, respaldar=True):
    ruta, _ = carpeta()
    yo = este_celular()
    conf = dict(estado['conf'])
    conf.pop('quien', None)
    escribir_json(archivo_propio(ruta), {
        'meta': {'quien': yo.get('quien', ''), 'id': yo['id'], 'guardado': dt.datetime.now().isoformat(timespec='seconds')},
        'conf': conf, 'db': estado['db']})
    if not respaldar:
        return
    os.makedirs(D_RESPALDOS, exist_ok=True)
    escribir_json(os.path.join(D_RESPALDOS, 'mm_caja_%s.json' % dt.date.today().isoformat()), estado)
    copias = sorted(f for f in os.listdir(D_RESPALDOS) if f.startswith('mm_caja_'))
    for viejo in copias[:-60]:
        os.remove(os.path.join(D_RESPALDOS, viejo))


def listar_respaldos():
    out = []
    try:
        nombres = sorted(os.listdir(D_RESPALDOS), reverse=True)
    except OSError:
        return out
    for f in nombres:
        if not f.endswith('.json'):
            continue
        d = leer_json(os.path.join(D_RESPALDOS, f))
        if not isinstance(d, dict):
            continue
        db = d.get('db') or {}
        cuenta = {k: sum(1 for r in db.get(k, []) if not r.get('del')) for k in ('ventas', 'pagos', 'perros', 'gastos')}
        m = re.search(r'(\d{4}-\d{2}-\d{2})(?:_(\d{2})(\d{2}))?', f)
        mod = dt.datetime.fromtimestamp(os.path.getmtime(os.path.join(D_RESPALDOS, f)))
        out.append({'archivo': f, 'fecha': m.group(1) if m else '', 'hora': mod.strftime('%H:%M'),
                    'tipo': 'antes' if f.startswith('antes_') else 'diario', 'conteo': cuenta,
                    'motivo': 'importar' if f.startswith('antes_de_importar') else ''})
    return out


def restaurar(archivo):
    """Regresa TODO a como estaba en el respaldo, en los dos celulares (gana por ser el cambio más nuevo)."""
    path = os.path.join(D_RESPALDOS, os.path.basename(archivo))
    resp = leer_json(path)
    if not isinstance(resp, dict) or not isinstance(resp.get('db'), dict):
        raise ValueError('No pude leer ese respaldo')
    estado, _, _, _ = estado_actual()
    marca = dt.datetime.now().strftime('%Y-%m-%d_%H%M%S')
    os.makedirs(D_RESPALDOS, exist_ok=True)
    escribir_json(os.path.join(D_RESPALDOS, 'antes_de_restaurar_%s.json' % marca), estado)
    ahora = int(time.time() * 1000)
    nuevo = {'conf': dict(resp.get('conf') or estado['conf']), 'db': {}}
    nuevo['conf']['upd'] = ahora
    for k in COLS:
        del_resp = resp['db'].get(k, [])
        ids = {r.get('id') for r in del_resp}
        recs = [dict(r, upd=ahora) for r in del_resp]
        recs += [dict(r, upd=ahora, **{'del': True}) for r in estado['db'].get(k, []) if r.get('id') not in ids and not r.get('del')]
        nuevo['db'][k] = recs
    guardar_propio(mezclar(estado, nuevo), respaldar=False)
    antes = sorted(f for f in os.listdir(D_RESPALDOS) if f.startswith('antes_de_restaurar_'))
    for viejo in antes[:-10]:
        os.remove(os.path.join(D_RESPALDOS, viejo))


def migrar():
    """Pasa a la carpeta actual los datos de versiones anteriores de MM_Caja."""
    ruta, compartida = carpeta()
    propio = archivo_propio(ruta)
    fuentes = []
    datos_viejos, conf_vieja = (leer_json(p) for p in VIEJOS)
    if isinstance(datos_viejos, dict):
        quien_viejo = (conf_vieja or {}).get('quien') or este_celular().get('quien') or ''
        for k in COLS:
            for r in datos_viejos.get(k, []):
                r.setdefault('quien', quien_viejo)
        conf = {k: v for k, v in (conf_vieja or {}).items() if k in ('precios', 'aromas')}
        conf['upd'] = 1
        fuentes.append((VIEJOS[0], {'conf': conf, 'db': datos_viejos}))
        if conf_vieja and conf_vieja.get('quien') and not este_celular().get('quien'):
            yo = este_celular()
            yo['quien'] = conf_vieja['quien']
            escribir_json(F_LOCAL, yo)
    local = archivo_propio(BASE)
    if compartida and local != propio and os.path.exists(local):
        fuentes.append((local, leer_json(local, {})))
    if not fuentes:
        return
    with CANDADO:
        estado = mezclar({'conf': {}, 'db': {}}, leer_json(propio, {}) or {})
        for _, d in fuentes:
            estado = mezclar(estado, d)
        guardar_propio(estado)
        for path, _ in fuentes:
            os.replace(path, path + '.migrado')
        if datos_viejos is not None and os.path.exists(VIEJOS[1]):
            os.replace(VIEJOS[1], VIEJOS[1] + '.migrado')


