function guardarVenta() {
  document.activeElement && document.activeElement.blur();
  const items = carrito.slice();
  const desc = Math.min(num(F.desc), subtotal(items));
  const total = r2(subtotal(items) - desc);
  const cliente = (F.cliente || '').trim().toUpperCase();
  if (!items.length) { toast('El carrito está vacío', true); return; }
  if (!cliente) { toast('Escribe el nombre del cliente', true); $('#cli').focus(); return; }
  let pago = null;
  if (F.pago === 0) pago = [total, EFE];
  else if (F.pago === 1) pago = [total, TRA];
  else if (F.pago === 2) {
    const m = num(F.parte);
    if (m <= 0) { toast('Escribe cuánto paga hoy', true); return; }
    pago = [Math.min(m, total), F.metParte === 0 ? EFE : TRA];
  }
  const pedido = F.ent === 1;
  const fechaEnt = F.fecha;
  if (pedido && !fechaEnt) { toast('Elige la fecha de entrega', true); return; }
  if (!pedido && !MUESTRA_VENTA) {
    const faltan = contar(items).filter(c => disponible(c.a, c.t) < c.n);
    if (faltan.length && !confirm('En inventario no alcanza: ' + faltan.map(c => c.a + ' ' + c.t + ' (quedan ' + Math.max(0, disponible(c.a, c.t)) + ')').join(', ') +
        '.\n\n¿Guardar la venta de todos modos?')) return;
  }
  const id = nuevoId('V');
  const v = {id: id, fecha: hoy(), hora: hora(), cliente: cliente, items: items, desc: desc, pedido: pedido,
    entrega: pedido ? fechaEnt : null, entregado: !pedido, nota: pedido ? (F.nota || '').trim() : '',
    quien: S.conf.quien, exp_venta: false, exp_pedido: false};
  nuevo('ventas', v);
  if (pago) agregarPago(cliente, pago[0], pago[1], id);
  if (F.tel) guardarTel(cliente, F.tel);
  if (MUESTRA_VENTA) {
    const m = S.v.muestras.find(x => x.id === MUESTRA_VENTA);
    if (m) { m.estado = 'vendida'; m.venta = id; m.fin = hoy(); tocar(m); }
    MUESTRA_VENTA = null;
  }
  cambio();
  carrito = []; guardarCarrito();
  const pagado = pago ? pago[0] : 0;
  window._ticket = ticketDe(v);
  window._ultimaVenta = id;
  pila = [{n: 'menu'}, {n: 'venta'}];
  render(true);
  abrirModal('<h2>✅ Venta guardada</h2><p class="sub">' + esc(cliente) + ' · ' + dinero(total) +
    (total - pagado > 0 ? ' · debe ' + dinero(total - pagado) : ' · pagado') + (pedido ? '\n📦 Entrega ' + corta(fechaEnt) : '') + '</p>' +
    '<div class="fila"><button class="btn sec" data-act="copiarTicket">📋 Copiar ticket</button>' +
    '<button class="btn sec" data-act="whatsTicket">💬 WhatsApp</button></div>' +
    '<button class="btn" data-act="cerrar">🛍️ Otra venta</button>' +
    '<div class="fila"><button class="btn rojo chico" data-act="deshacerVenta">↩️ Deshacer venta</button>' +
    '<button class="btn gris chico" data-act="cerrarMenu">Ir al menú</button></div>');
}

