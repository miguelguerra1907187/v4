def url_lanzar(pantalla='intercambio'):
    """Liga que abre Pythonista, corre esta misma caja y regresa a Safari en la pantalla indicada."""
    script = SCRIPT
    for raiz, root in ((os.path.realpath(DOCS), ''), (os.path.realpath(ICLOUD_PY), 'icloud')):
        if script.startswith(raiz + os.sep):
            rel = urllib.parse.quote(os.path.relpath(script, raiz))
            return 'pythonista3://%s?action=run%s&argv=%s' % (rel, '&root=' + root if root else '', pantalla)
    return 'pythonista3://%s?action=run&argv=%s' % (urllib.parse.quote(os.path.basename(script)), pantalla)


def rescatar_datos():
    """Por si MM_Caja.py nuevo quedó en otra carpeta que el viejo: busca el archivo de datos de ESTE
    celular (datos_<id>.json) en las carpetas de Pythonista y lo junta con el actual. No borra ni mueve nada."""
    ruta, _ = carpeta()
    propio = archivo_propio(ruta)
    nombre = os.path.basename(propio)
    otros = []
    for raiz in (DOCS, ICLOUD_PY):
        if not os.path.isdir(raiz):
            continue
        base_n = raiz.rstrip(os.sep).count(os.sep)
        for dp, dns, fns in os.walk(raiz):
            if dp.count(os.sep) - base_n >= 3:
                dns[:] = []
            dns[:] = [d for d in dns if not d.startswith('.') and d not in ('mm_caja_respaldos', 'site-packages', 'site-packages-3', 'Examples')]
            if nombre in fns:
                p = os.path.join(dp, nombre)
                if os.path.realpath(p) != os.path.realpath(propio):
                    otros.append(p)
    if not otros:
        return 0
    with CANDADO:
        estado = mezclar({'conf': {}, 'db': {}}, leer_json(propio, {}) or {})
        antes = sum(len(v) for v in estado['db'].values())
        for p in otros:
            d = leer_json(p)
            if isinstance(d, dict) and isinstance(d.get('db'), dict):
                estado = mezclar(estado, d)
        if sum(len(v) for v in estado['db'].values()) != antes:
            guardar_propio(estado)
            anotar_error('rescate', 'Se juntaron datos de este celular que estaban en: ' + ', '.join(otros))
    return len(otros)


def recuperar_de_respaldo():
    """Si el archivo de datos de este celular ya no existe (se borró junto con el código),
    junta el respaldo diario más reciente. Solo agrega: nunca borra nada."""
    ruta, compartida = carpeta()
    if compartida or os.path.exists(archivo_propio(ruta)):
        return ''
    if any(re.match(r'^datos_.*\.json$', n) for n in os.listdir(ruta)):
        return ''
    try:
        diarios = sorted(f for f in os.listdir(D_RESPALDOS) if re.match(r'^mm_caja_\d{4}-\d{2}-\d{2}\.json$', f))
    except OSError:
        return ''
    for f in reversed(diarios):
        d = leer_json(os.path.join(D_RESPALDOS, f))
        if isinstance(d, dict) and isinstance(d.get('db'), dict) and any(d['db'].values()):
            with CANDADO:
                estado, _, _, _ = estado_actual()
                guardar_propio(mezclar(estado, d), respaldar=False)
            anotar_error('rescate', 'No estaba el archivo de datos; se recuperó del respaldo ' + f)
            return f
    return ''


