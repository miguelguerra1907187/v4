let pendienteCorriendo = false;
async function seguirPendiente() {
  if (pendienteCorriendo) return;
  let p = null;
  try { p = JSON.parse(localStorage.getItem(LS_PEND)); } catch (e) {}
  if (!p) return;
  try { localStorage.removeItem(LS_PEND); } catch (e) {}
  if (Date.now() - (p.t || 0) > 180000) return;           // más de 3 minutos: ya no aplica
  pendienteCorriendo = true;
  try {
    if (pila[pila.length - 1].n !== 'intercambio') { pila = [{n: 'menu'}, {n: 'intercambio'}]; render(true); }
    cerrarModal();
    toast('Esperando a Pythonista...');
    if (!(await esperarPythonista(12000))) {
      try { localStorage.setItem(LS_PEND, JSON.stringify(p)); } catch (e) {}   // se reintenta al regresar a Safari
      abrirModal('<h2>Pythonista no contestó</h2><p class="sub">Toca ◀ Pythonista arriba a la izquierda (o abre tu atajo de la caja), espera un segundo y regresa a Safari: se termina solo.</p>' +
