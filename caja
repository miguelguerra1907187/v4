          '<p class="ayuda">Úsalo solo si de plano no despierta: puede faltar información que esté guardada en Pythonista.</p>' : '') +
        '<button class="btn gris" data-act="cerrar">Cerrar</button>');
      return;
    }
    await jalar();
    if (p.accion === 'exportar') await crearArchivo();
    else if (p.accion === 'importar') await revisarImport({contenido: p.contenido, nombre: p.nombre});
    else if (p.accion === 'revisar') await revisarImport({archivo: p.archivo});
    else if (p.accion === 'aplicar') await aplicarImportacion(p, null, true);
    else await cargarIntercambio();
