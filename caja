const pad = n => String(n).padStart(2, '0');
function isoDe(d) { return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()); }
function deIso(iso) { const p = iso.split('-').map(Number); return new Date(p[0], p[1] - 1, p[2]); }
