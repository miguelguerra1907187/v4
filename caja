  ofrecerDeshacer('Entregado a ' + v.cliente + (pg ? ' · cobrado ' + dinero(pg.monto) : '') + (s > 0 ? ' · debe ' + dinero(s) : ''), () => {
    const x = fresco('ventas', v); x.entregado = false; x.fecha_entregado = null; tocar(x);
    if (pg) borrarRec(fresco('pagos', pg));
