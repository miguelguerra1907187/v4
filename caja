/* =================== dinero por periodo =================== */
function rangoDe(per, fecha) {
  const h = hoy();
  if (per === 0) return [h, h, 'Hoy'];
  if (per === 1) { const a = enDias(-1); return [a, a, 'Ayer']; }
  if (per === 2) { const d = new Date(); const lunes = enDias(-((d.getDay() + 6) % 7)); return [lunes, h, 'Esta semana']; }
  if (per === 3) { return [h.slice(0, 8) + '01', h, 'Este mes']; }
  const f = fecha || h;
  return [f, f, larga(f)];
}
function conceptoPago(p) {
  const v = p.venta ? buscarVenta(p.venta) : null;
  if (!p.venta) return {t: 'Pago suelto' + (p.nota ? ': ' + p.nota : ''), v: null};
  if (!v) return {t: 'Venta borrada', v: null};
  let t;
  if (v.pedido && v.fecha === p.fecha) t = 'Pedido · anticipo/pago';
  else if (v.pedido) t = 'Pago de pedido del ' + corta(v.fecha);
  else if (v.fecha === p.fecha) t = 'Venta';
  else t = 'Abono de venta del ' + corta(v.fecha);
  return {t: t + ' · ' + resumenItems(v.items), v: v};
}
function calcularDinero(d1, d2, quien) {
  const en = f => f && f >= d1 && f <= d2;
  const mio = r => !quien || r.quien === quien;
  const ventas = S.v.ventas.filter(v => en(v.fecha) && mio(v));
  const pagos = S.v.pagos.filter(p => en(p.fecha) && mio(p));
  const perros = S.v.perros.filter(p => en(p.fecha) && mio(p));
  const gastos = S.v.gastos.filter(g => en(g.fecha) && mio(g));
  const suma = (l, m) => l.filter(x => !m || x.metodo === m).reduce((a, x) => a + x.monto, 0);
  const R = {
    ventas, pagos, perros, gastos,
    vendido: ventas.reduce((a, v) => a + totalVenta(v), 0),
    botes: ventas.reduce((a, v) => a + v.items.length, 0),
    efMM: suma(pagos, EFE), trMM: suma(pagos, TRA),
    efPe: suma(perros, EFE), trPe: suma(perros, TRA),
    gaEf: suma(gastos, EFE), gaTr: suma(gastos, TRA),
    pedNuevos: ventas.filter(v => v.pedido),
    pedEntregados: S.v.ventas.filter(v => v.pedido && v.entregado && en(v.fecha_entregado) && mio(v)),
  };
  R.costo = ventas.reduce((a, v) => a + costoVenta(v), 0);
  R.top = contar([].concat(...ventas.map(v => v.items))).sort((x, y) => y.n - x.n).slice(0, 5);
  R.fiado = ventas.reduce((a, v) => a + Math.max(0, totalVenta(v) - pagos.filter(p => p.venta === v.id).reduce((s, p) => s + p.monto, 0)), 0);
  R.ef = R.efMM + R.efPe - R.gaEf;
  R.tr = R.trMM + R.trPe - R.gaTr;
  const movs = [];
  pagos.forEach(p => { const c = conceptoPago(p); movs.push({f: p.fecha, h: p.hora || '', nom: p.cliente, t: c.t, m: p.monto, met: p.metodo, venta: c.v ? c.v.id : null, tipo: 'mm', q: p.quien}); });
  perros.forEach(p => movs.push({f: p.fecha, h: p.hora || '', nom: '🐶 Perritos · ' + (p.tipo || 'Baño'), t: p.nota || (p.tipo || 'Baño'), m: p.monto, met: p.metodo, tipo: 'pe', q: p.quien}));
  gastos.forEach(g => movs.push({f: g.fecha, h: g.hora || '', nom: '💸 Gasto', t: g.nota || 'Gasto', m: -g.monto, met: g.metodo, tipo: 'ga', q: g.quien}));
  movs.sort((a, b) => (a.f + a.h).localeCompare(b.f + b.h));
  R.movs = movs;
  return R;
}
/* ---------- dinero que tenemos (caja y cuenta) ---------- */
const NEGOCIOS = {mm: '🧴 Aromas', pe: '🐶 Perritos'};
const LLAVES_DINERO = [['mm', EFE, 'mmE'], ['mm', TRA, 'mmT'], ['pe', EFE, 'peE'], ['pe', TRA, 'peT']];
function hayArranque() { return S.v.saldos.length > 0; }
function negocioGasto(g) { return g.negocio === 'pe' ? 'pe' : 'mm'; }
function baseSaldo(n, m) {
  return S.v.saldos.filter(x => x.negocio === n && x.metodo === m).sort((a, b) => (a.cre || 0) - (b.cre || 0)).pop() || null;
}
// Lo que hay = punto de partida (o último ajuste) + lo que entró después − gastos después
function enCaja() {
  const C = {mm: {}, pe: {}};
  LLAVES_DINERO.forEach(([n, m]) => {
    const b = baseSaldo(n, m), desde = b ? (b.cre || 0) : 0;
    const despues = r => r.metodo === m && (r.cre || 0) > desde;
    const entra = (n === 'mm' ? S.v.pagos : S.v.perros).filter(despues).reduce((a, r) => a + r.monto, 0);
    const sale = S.v.gastos.filter(g => negocioGasto(g) === n && despues(g)).reduce((a, g) => a + g.monto, 0);
    C[n][m] = r2((b ? b.monto : 0) + entra - sale);
  });
  C.ef = r2(C.mm[EFE] + C.pe[EFE]); C.tr = r2(C.mm[TRA] + C.pe[TRA]);
  return C;
}
function movsDinero(lim) {
