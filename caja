def resumen_intercambio():
    log = leer_intercambio()
    imp = {}
    for x in log['importados']:
        q = x.get('quien') or 'otro celular'
        if (x.get('importado') or '') >= (imp.get(q, {}).get('importado') or ''):
            imp[q] = {'importado': x.get('importado') or '', 'exportado': x.get('exportado') or ''}
    return {'importes': imp, 'exportado': log['exportados'][-1].get('exportado', '') if log['exportados'] else ''}


def nombre_seguro(s):
    s = ''.join(c for c in unicodedata.normalize('NFKD', s or '') if not unicodedata.combining(c))
    return re.sub(r'[^A-Za-z0-9]+', '', s)[:20] or 'Celular'


def escribir_texto(path, texto):
    tmp = os.path.join(os.path.dirname(path), '.' + os.path.basename(path) + '.tmp')
    with open(tmp, 'w', encoding='utf-8') as f:
        f.write(texto)
    os.replace(tmp, path)


def nombre_libre(carp, base):
    nombre, n = base + '.json', 2
    while os.path.exists(os.path.join(carp, nombre)):
        nombre, n = '%s_%d.json' % (base, n), n + 1
    return nombre


def exportar_datos():
    """Crea el archivo con TODO (incluye borrados, para que también se borren en el otro celular)."""
    estado, _, _, _ = estado_actual()
    yo = este_celular()
    ahora = dt.datetime.now()
    conf = dict(estado['conf'])
    conf.pop('quien', None)
    db = estado['db']
    conteo = {k: sum(1 for r in db.get(k, []) if not r.get('del')) for k in COLS}
    datos = {'tipo': 'gg_caja_export', 'version': VERSION,
             'meta': {'quien': yo.get('quien', ''), 'id': yo['id'], 'exportado': ahora.isoformat(timespec='seconds'), 'conteo': conteo},
             'conf': conf, 'db': db}
    carp = carpeta_intercambio()
    nombre = nombre_libre(carp, 'GG_Caja_%s_%s' % (nombre_seguro(yo.get('quien')), ahora.strftime('%Y-%m-%d_%Hh%M')))
    texto = json.dumps(datos, ensure_ascii=False, separators=(',', ':'))
    escribir_texto(os.path.join(carp, nombre), texto)
    log = leer_intercambio()
    log['exportados'].append({'archivo': nombre, 'exportado': datos['meta']['exportado']})
    for viejo in [x['archivo'] for x in log['exportados']][:-30]:      # deja las últimas 30 copias propias
        try:
            os.remove(os.path.join(carp, viejo))
        except OSError:
            pass
    log['exportados'] = log['exportados'][-30:]
    guardar_intercambio(log)
    return {'nombre': nombre, 'texto': texto, 'carpeta': ruta_bonita(carp), 'conteo': conteo, 'intercambio': resumen_intercambio()}


def leer_export(d):
    """Acepta un archivo de exportación o un datos_<celular>.json. Regresa {'meta','conf','db'}."""
    if isinstance(d, (str, bytes)):
        try:
            d = json.loads(d)
        except ValueError:
            d = None
    if not isinstance(d, dict) or not isinstance(d.get('db'), dict):
        raise ValueError('Ese archivo no es de la caja (o llegó incompleto).')
    meta = d.get('meta') or {}
    db = {k: [r for r in (d['db'].get(k) or []) if isinstance(r, dict) and r.get('id')] for k in COLS}
    return {'meta': {'quien': meta.get('quien') or '', 'id': meta.get('id') or '',
                     'exportado': meta.get('exportado') or meta.get('guardado') or ''},
            'conf': d.get('conf') or {}, 'db': db}


def clave_export(e):
    return '%s|%s' % (e['meta']['id'], e['meta']['exportado'])


def archivos_intercambio():
    yo = este_celular()['id']
    hechos = {x.get('clave'): x for x in leer_intercambio()['importados']}
    out, nube, malos, vistos = [], [], [], set()
    for d in dirs_intercambio():
        try:
            nombres = os.listdir(d)
        except OSError:
            continue
        for n in nombres:
            m = PATRON_EXPORT_NUBE.match(n)
            if m:
                pedir_descarga(os.path.join(d, m.group(1)))
                nube.append(m.group(1))
                continue
            if not PATRON_EXPORT.match(n):
                continue
            try:
                e = leer_export(leer_json(os.path.join(d, n)))
            except ValueError:
                malos.append(n)
                continue
            clave = clave_export(e)
            if clave in vistos:          # el mismo archivo guardado en dos lugares
                continue
            vistos.add(clave)
            out.append({'archivo': n, 'carpeta': ruta_bonita(d), 'quien': e['meta']['quien'], 'exportado': e['meta']['exportado'],
                        'propio': e['meta']['id'] == yo, 'importado': (hechos.get(clave) or {}).get('importado', ''),
                        'ventas': sum(1 for r in e['db']['ventas'] if not r.get('del'))})
    out.sort(key=lambda x: x['exportado'], reverse=True)
    return {'carpeta': ruta_bonita(carpeta_intercambio()), 'archivos': out, 'nube': nube, 'malos': malos}


def buscar_export(nombre):
    base = os.path.basename(nombre or '')
    for d in dirs_intercambio():
        p = os.path.join(d, base)
        if base and os.path.isfile(p):
            return p
    raise ValueError('No encontré el archivo %s' % base)


def guardar_recibido(texto, nombre_original):
    """Un archivo elegido a mano se copia a la carpeta estándar, para que quede ahí como los demás."""
    e = leer_export(texto)
    carp = carpeta_intercambio()
    nombre = os.path.basename(nombre_original or '')
    if not PATRON_EXPORT.match(nombre):
        try:
            cuando = dt.datetime.fromisoformat(e['meta']['exportado'][:19])
        except ValueError:
            cuando = dt.datetime.now()
        nombre = 'GG_Caja_%s_%s.json' % (nombre_seguro(e['meta']['quien']), cuando.strftime('%Y-%m-%d_%Hh%M'))
    p = os.path.join(carp, nombre)
    if os.path.exists(p):
        try:
            if clave_export(leer_export(leer_json(p))) == clave_export(e):
                return e, nombre
        except ValueError:
            pass
        nombre = nombre_libre(carp, nombre[:-5])
    escribir_texto(os.path.join(carp, nombre), texto if isinstance(texto, str) else json.dumps(texto, ensure_ascii=False))
    return e, nombre


# --- comparar para no duplicar ---
def _t(x):
    return unicodedata.normalize('NFC', str(x or '')).strip().upper()


def _items_clave(v):
    return tuple(sorted((_t(i.get('aroma')), _t(i.get('tam'))) for i in v.get('items') or []))


def _num(x):
    try:
        return round(float(x or 0), 2)
    except (TypeError, ValueError):
        return 0


CLAVES = {
    'ventas': lambda r: (_t(r.get('cliente')), r.get('fecha'), _items_clave(r)),
    'pagos': lambda r: (_t(r.get('cliente')), r.get('fecha'), _num(r.get('monto')), r.get('metodo'), r.get('venta') or ''),
    'perros': lambda r: (r.get('fecha'), _num(r.get('monto')), r.get('metodo'), _t(r.get('tipo') or 'Baño')),
    'gastos': lambda r: (r.get('fecha'), _num(r.get('monto')), r.get('metodo'), r.get('negocio') or 'mm'),
    'muestras': lambda r: (r.get('fecha'), _t(r.get('aroma')), _t(r.get('tam')), _t(r.get('persona'))),
}


def parecidos(k, a, b):
    if k == 'corridas':
        return bool((a.get('inicio') and a.get('inicio') == b.get('inicio')) or _t(a.get('nombre')) == _t(b.get('nombre')))
    return CLAVES[k](a) == CLAVES[k](b)


def _resumen_items(items):
    cuenta = []
    for i in items or []:
        c = (i.get('aroma', ''), i.get('tam', ''))
        for x in cuenta:
            if x[0] == c:
                x[1] += 1
                break
        else:
            cuenta.append([c, 1])
    return ', '.join('%d× %s %s' % (n, a, t) for (a, t), n in cuenta)


def _dinero(x):
    x = _num(x)
    return '$' + ('{:,.0f}'.format(x) if x == int(x) else '{:,.2f}'.format(x))


def _fecha_corta(iso):
    try:
        f = dt.date.fromisoformat((iso or '')[:10])
        return '%d %s' % (f.day, MESES_C[f.month - 1])
    except ValueError:
        return iso or ''


def _ficha(k, r, act):
    met = (r.get('metodo') or '').lower()
    f = {'id': r.get('id'), 'quien': r.get('quien') or '', 'hora': r.get('hora') or '', 'pagado': 0}
    if k == 'ventas':
        pagos = [p for p in act['pagos'] if p.get('venta') == r.get('id')]
        pagado = _num(sum(_num(p.get('monto')) for p in pagos))
        total = _num(sum(_num(i.get('precio')) for i in r.get('items') or []) - _num(r.get('desc')))
        mets = sorted({(p.get('metodo') or '').lower() for p in pagos} - {''})
        det = '%s · %s · %s' % (_resumen_items(r.get('items')), _dinero(total),
                               ('pagado ' + _dinero(pagado) + (' (' + '/'.join(mets) + ')' if mets else '')) if pagado else 'no ha pagado')
        if r.get('pedido') and not r.get('entregado'):
            det += ' · pedido'
        f.update(detalle=det, pagado=pagado)
    elif k == 'pagos':
        f['detalle'] = '%s · %s%s' % (_dinero(r.get('monto')), met, (' · ' + r['nota']) if r.get('nota') else '')
    elif k == 'perros':
        f['detalle'] = '%s · %s · %s%s' % (r.get('tipo') or 'Baño', _dinero(r.get('monto')), met, (' · ' + r['nota']) if r.get('nota') else '')
    elif k == 'gastos':
        f['detalle'] = '%s · %s · %s' % (r.get('nota') or 'Gasto', _dinero(r.get('monto')), met)
    elif k == 'muestras':
        f['detalle'] = '%s %s · %s' % (r.get('aroma', ''), r.get('tam', ''), r.get('persona', ''))
    elif k == 'corridas':
        movs = [m for m in act['movs'] if m.get('corrida') == r.get('id') and (m.get('cambio') or 0) > 0]
        ch = sum(m['cambio'] for m in movs if m.get('tam') == 'CH')
        g = sum(m['cambio'] for m in movs if m.get('tam') == 'G')
        f['detalle'] = '%s · %s · %d chicos · %d grandes' % (r.get('nombre') or 'Corrida', _fecha_corta(r.get('inicio')), ch, g)
    return f


def _desc_corta(k, r):
    f = _fecha_corta(r.get('fecha') or r.get('inicio'))
    if k == 'ventas':
        tot = _num(sum(_num(i.get('precio')) for i in r.get('items') or []) - _num(r.get('desc')))
        return 'Venta de %s (%s) · %s · %s' % (r.get('cliente', ''), f, _resumen_items(r.get('items')), _dinero(tot))
    if k == 'pagos':
        return 'Pago de %s (%s) · %s' % (r.get('cliente', ''), f, _dinero(r.get('monto')))
    if k == 'perros':
        return 'Perritos (%s) · %s' % (f, _dinero(r.get('monto')))
    if k == 'gastos':
        return 'Gasto (%s) · %s %s' % (f, r.get('nota') or '', _dinero(r.get('monto')))
    if k == 'cortes':
        return 'Corte de %s (%s)' % (r.get('quien', ''), f)
    if k == 'movs':
        return 'Inventario %s %s %+d (%s)' % (r.get('aroma', ''), r.get('tam', ''), r.get('cambio') or 0, f)
    if k == 'clientes':
        return 'Cliente %s' % r.get('nombre', '')
    if k == 'muestras':
        return 'Muestra %s %s · %s' % (r.get('aroma', ''), r.get('tam', ''), r.get('persona', ''))
    if k == 'corridas':
        return 'Corrida %s' % (r.get('nombre') or '')
    return 'Dinero: %s' % (r.get('motivo') or '')


def _titulo_sospecha(k, r):
    if k == 'ventas':
        return 'Posible venta repetida: %s (%s)' % (r.get('cliente', ''), _fecha_corta(r.get('fecha')))
    if k == 'pagos':
        return 'Posible pago repetido: %s (%s)' % (r.get('cliente', ''), _fecha_corta(r.get('fecha')))
    if k == 'perros':
        return 'Posible registro de perritos repetido (%s)' % _fecha_corta(r.get('fecha'))
    if k == 'gastos':
        return 'Posible gasto repetido (%s)' % _fecha_corta(r.get('fecha'))
    if k == 'muestras':
        return 'Posible muestra repetida: %s' % r.get('persona', '')
    return 'Posible corrida repetida: %s' % (r.get('nombre') or '')


def _es_conteo(m):
    return m.get('tipo') in ('conteo', 'inicial') or bool(re.match(r'^(Conteo|Inventario inicial)', m.get('motivo') or ''))


def analizar(local, inc, decisiones=None, borrar=None, dinero=None):
    """Compara lo de este celular (local) con el archivo (inc).
    Sin decisiones: solo dice qué pasaría. Con decisiones: regresa también 'final' (ya juntado).
    borrar: si se aplican aquí los borrados que hizo el otro celular. None = decidir solo
    (si son 3 o menos sí; si son más NO, para que un "Borrar todo" del otro celular no borre aquí)."""
    yo = este_celular()
    quien_inc = inc['meta'].get('quien') or ''
    L = {k: {r.get('id'): r for r in local['db'].get(k, [])} for k in COLS}
    # borrados del otro celular sobre cosas que aquí siguen vivas
    borr, repetidos = [], 0
    for k in COLS:
        for r in inc['db'].get(k, []):
            x = L[k].get(r.get('id'))
            if r.get('del') and x is not None and not x.get('del') and (r.get('upd') or 0) > (x.get('upd') or 0):
                if r.get('borrado_por') == 'repetido':
                    repetidos += 1          # el otro celular ya decidió que era repetido: se aplica siempre
                else:
                    borr.append((k, x))
    # para contar y mostrar: un pago que se borró junto con su venta no cuenta aparte
    v_borr = {x.get('id') for k, x in borr if k == 'ventas'}
    principales = [(k, x) for k, x in borr if not (k == 'pagos' and x.get('venta') in v_borr)]
    if borrar is None:
        borrar = len(principales) <= 3
    if borr and not borrar:
        quitar = {(k, x.get('id')) for k, x in borr}
        inc = dict(inc, db={k: [r for r in inc['db'].get(k, []) if (k, r.get('id')) not in quitar] for k in COLS})
    merged = mezclar(local, inc)
    resumen, nuevos = {}, {k: [] for k in COLS}
    for k in COLS:
        n = a = b = 0
        for r in inc['db'].get(k, []):
            x = L[k].get(r.get('id'))
            if x is None:
                if not r.get('del'):
                    n += 1
                    nuevos[k].append(r)
            elif (r.get('upd') or 0) > (x.get('upd') or 0) and not (r.get('del') and x.get('del')):
                if r.get('del'):
                    b += 1
                else:
                    a += 1
        resumen[k] = {'nuevos': n, 'actualizados': a, 'borrados': b}
    # se compara contra cómo quedaría todo ya juntado (así un borrado que viene en el archivo cuenta)
    act = {k: [r for r in merged['db'][k] if not r.get('del')] for k in COLS}
    ids_nuevos = {k: {r.get('id') for r in nuevos[k]} for k in COLS}

    clientes_dup = []
    for r in nuevos['clientes']:
        nom = _t(r.get('nombre'))
        x = next((c for c in act['clientes'] if c.get('id') not in ids_nuevos['clientes'] and _t(c.get('nombre')) == nom), None)
        if x:
            clientes_dup.append((r, x))
    resumen['clientes']['nuevos'] -= len(clientes_dup)

    sospechas = []
    for k in ('corridas', 'ventas', 'pagos', 'perros', 'gastos', 'muestras'):
        usados = set()
        viejos = [r for r in act[k] if r.get('id') not in ids_nuevos[k]]
        for r in nuevos[k]:
            for x in viejos:
                if x.get('id') in usados or (x.get('quien') or '') == (r.get('quien') or ''):
                    continue
                if parecidos(k, x, r):
                    usados.add(x.get('id'))
                    loc, suyo = _ficha(k, x, act), _ficha(k, r, act)
                    sug = 'suyo' if (k == 'ventas' and suyo['pagado'] > loc['pagado']) else 'local'
                    sospechas.append({'sid': '%s:%s' % (k, r.get('id')), 'col': k, 'titulo': _titulo_sospecha(k, r),
                                      'local': loc, 'suyo': suyo, 'sugerido': sug})
                    break

    avisos = []
    uid = inc['meta'].get('id') or ''
    log = leer_intercambio()
    ya = next((x for x in reversed(log['importados']) if x.get('clave') == clave_export(inc)), None)
    if uid and uid == yo['id']:
        avisos.append({'n': 'amar', 't': 'Este archivo lo creaste tú en este celular', 'd': 'No trae nada de otro celular.'})
    if ya:
        avisos.append({'n': 'info', 't': 'Ya importaste este archivo el %s a las %s' % (_fecha_corta(ya.get('importado')), (ya.get('importado') or '')[11:16]),
                       'd': 'Importarlo otra vez no duplica nada.'})
    desde = max([x.get('importado_ms') or 0 for x in log['importados'] if x.get('id') == uid] or [0])
    if not any(not r.get('del') for k in ('ventas', 'pagos', 'perros', 'movs', 'saldos') for r in local['db'].get(k, [])):
        avisos.append({'n': 'info', 't': 'Este celular no tiene datos todavía', 'd': 'Se copia todo tal cual viene en el archivo.'})
    inv_suyo = [m for m in nuevos['movs'] if _es_conteo(m)]
    inv_mio = [m for m in act['movs'] if m.get('id') not in ids_nuevos['movs'] and _es_conteo(m)
               and (m.get('quien') or '') != quien_inc and (m.get('cre') or 0) > desde]
    if inv_suyo and inv_mio:
        avisos.append({'n': 'amar', 't': 'Los dos contaron o pusieron inventario por separado',
                       'd': 'Después de importar revisa Inventario; si no cuadra con lo que tienen, usa "Contar todo el inventario".'})
    din_suyo = nuevos['saldos']
    din_mio = [s for s in act['saldos'] if s.get('id') not in ids_nuevos['saldos'] and (s.get('quien') or '') != quien_inc and (s.get('cre') or 0) > desde]
    if din_suyo and din_mio:
        avisos.append({'n': 'amar', 't': 'Los dos pusieron o ajustaron el dinero por separado',
                       'd': 'La app toma el más reciente de cada caja. Revisa "¿Cuánto tenemos?" y ajusta a lo real si hace falta.'})
    conf_nueva = (inc['conf'].get('upd') or 0) > (local['conf'].get('upd') or 0)
    # Celular "nuevo" (sin ventas, pagos, inventario...) pero con su propio punto de partida de dinero:
    # al ser más reciente, taparía el dinero del otro celular. Se pregunta cuál usar.
    ids_inc_saldos = {s.get('id') for s in inc['db'].get('saldos', [])}
    mis_saldos = [s for s in local['db'].get('saldos', []) if not s.get('del') and s.get('id') not in ids_inc_saldos]
    con_movimiento = any(not r.get('del') for k in ('ventas', 'pagos', 'perros', 'gastos', 'movs', 'cortes') for r in local['db'].get(k, []))
    dinero_propio = bool(mis_saldos and not con_movimiento and any(not s.get('del') for s in inc['db'].get('saldos', [])))
    if dinero_propio:                     # ya se pregunta aparte: se quita el aviso amarillo del dinero
        avisos = [a for a in avisos if not a['t'].startswith('Los dos pusieron o ajustaron el dinero')]
    if conf_nueva and [_t(a) for a in inc['conf'].get('aromas') or []] != [_t(a) for a in local['conf'].get('aromas') or []] and inc['conf'].get('aromas'):
        avisos.append({'n': 'amar', 't': 'El otro celular cambió la lista de aromas',
                       'd': 'Quedaría: ' + ', '.join(inc['conf']['aromas']) + '. Ninguna venta se borra, pero un aroma que no esté en la lista no se ve en Inventario.'})
    if uid and uid != yo['id'] and quien_inc and _t(quien_inc) == _t(yo.get('quien')):
        avisos.append({'n': 'rojo', 't': 'Los dos celulares tienen el mismo nombre (%s)' % quien_inc,
                       'd': 'Así no se sabe quién anotó cada cosa ni se detectan bien las ventas repetidas. Cambia el nombre en Ajustes de uno de los dos antes de importar.'})

    out = {'resumen': resumen, 'sospechas': sospechas, 'avisos': avisos, 'conf': conf_nueva,
           'borrar': bool(borrar), 'n_borrados': len(principales), 'repetidos_resueltos': repetidos,
           'dinero_propio': dinero_propio,
           'dinero_detalle': ['%s %s: %s' % ('Fragancias' if s.get('negocio') == 'mm' else 'Perritos', (s.get('metodo') or '').lower(), _dinero(s.get('monto')))
                              for s in mis_saldos[:8]],
           'borrados_detalle': [_desc_corta(k, x) for k, x in principales[:8]],
           'quien': quien_inc, 'exportado': inc['meta'].get('exportado') or '', 'propio': bool(uid and uid == yo['id']),
           'ya': (ya or {}).get('importado', '')}
    out['nada'] = not (sospechas or conf_nueva or any(v['nuevos'] or v['actualizados'] or v['borrados'] for v in resumen.values()))
    if decisiones is None:
        return out

    # ---- aplicar: lo descartado se marca como borrado (con la hora de ahora) para que no regrese
    ahora = int(time.time() * 1000)
    loc2, inc2 = copy.deepcopy(local), copy.deepcopy(inc)
    matar = {k: set() for k in COLS}
    tel = {}
    descartados = 0
    for s in sospechas:
        d = decisiones.get(s['sid'])
        if d not in ('local', 'suyo', 'ambos') or (d == 'suyo' and s['col'] not in ('ventas', 'corridas')):
            d = s['sugerido']
        if d == 'ambos':
            continue
        matar[s['col']].add(s['suyo']['id'] if d == 'local' else s['local']['id'])
        descartados += 1
    if dinero_propio and dinero != 'local':
        for s in mis_saldos:
            matar['saldos'].add(s.get('id'))
    for r, x in clientes_dup:
        matar['clientes'].add(r.get('id'))
        if r.get('tel') and not x.get('tel'):
            tel[x.get('id')] = r['tel']
    for est in (loc2, inc2):            # lo que depende de lo descartado: pagos de esa venta, botes de esa corrida
        for p in est['db'].get('pagos', []):
            if p.get('venta') and p.get('venta') in matar['ventas']:
                matar['pagos'].add(p.get('id'))
        for m in est['db'].get('movs', []):
            if m.get('corrida') and m.get('corrida') in matar['corridas']:
                matar['movs'].add(m.get('id'))
    for est in (loc2, inc2):
        for k in COLS:
            for r in est['db'].get(k, []):
                if r.get('id') in matar[k] and not r.get('del'):
                    r['del'] = True
                    r['upd'] = ahora
                    r['borrado_por'] = 'repetido'
                if k == 'clientes' and r.get('id') in tel:
                    r['tel'] = tel[r['id']]
                    r['upd'] = ahora
    final = mezclar(loc2, inc2)
    vivos = {k: {r.get('id') for r in final['db'][k] if not r.get('del')} for k in COLS}
    out['agregados'] = {k: sum(1 for r in nuevos[k] if r.get('id') in vivos[k]) for k in COLS}
    out['descartados'] = descartados
    out['final'] = final
    return out


NOMBRES_COL = {'ventas': ('venta', 'ventas'), 'pagos': ('pago', 'pagos'), 'perros': ('registro de perritos', 'registros de perritos'),
               'gastos': ('gasto', 'gastos'), 'movs': ('movimiento de inventario', 'movimientos de inventario'),
               'cortes': ('corte', 'cortes'), 'clientes': ('cliente', 'clientes'), 'muestras': ('muestra', 'muestras'),
               'corridas': ('corrida', 'corridas'), 'saldos': ('ajuste de dinero', 'ajustes de dinero')}


def importar(nombre, decisiones, borrar=None, dinero=None):
    inc = leer_export(leer_json(buscar_export(nombre)))
    estado, _, _, _ = estado_actual()
    marca = dt.datetime.now().strftime('%Y-%m-%d_%H%M%S')
    os.makedirs(D_RESPALDOS, exist_ok=True)
    escribir_json(os.path.join(D_RESPALDOS, 'antes_de_importar_%s.json' % marca), estado)
    antes = sorted(f for f in os.listdir(D_RESPALDOS) if f.startswith('antes_de_importar_'))
    for viejo in antes[:-15]:
        os.remove(os.path.join(D_RESPALDOS, viejo))
    a = analizar(estado, inc, decisiones or {}, borrar, dinero)
    guardar_propio(a['final'])
    partes = ['+%d %s' % (n, NOMBRES_COL[k][0 if n == 1 else 1]) for k, n in a['agregados'].items() if n]
    act = sum(v['actualizados'] + (v['borrados'] if a['borrar'] else 0) for v in a['resumen'].values())
    texto = ('De %s: ' % (a['quien'] or 'otro celular')) + (', '.join(partes) if partes else 'nada nuevo')
    if act:
        texto += ' · %d con cambios' % act
    if a['descartados']:
        texto += ' · %s' % ('1 repetido no se sumó' if a['descartados'] == 1 else '%d repetidos no se sumaron' % a['descartados'])
    if a['n_borrados'] and not a['borrar']:
        texto += ' · ' + ('1 borrado del otro celular no se aplicó aquí' if a['n_borrados'] == 1 else
                          '%d borrados del otro celular no se aplicaron aquí' % a['n_borrados'])
    if a['dinero_propio']:
        texto += ' · dinero: ' + ('se conservó el de este celular' if dinero == 'local' else 'se usó el de %s' % (a['quien'] or 'otro celular'))
    if a['conf']:
        texto += ' · precios/aromas actualizados'
    log = leer_intercambio()
    log['importados'].append({'clave': clave_export(inc), 'id': inc['meta']['id'], 'quien': a['quien'], 'exportado': a['exportado'],
                              'archivo': os.path.basename(nombre), 'importado': dt.datetime.now().isoformat(timespec='seconds'),
                              'importado_ms': int(time.time() * 1000), 'agregados': sum(a['agregados'].values())})
    guardar_intercambio(log)
    return {'texto': texto, 'agregados': a['agregados'], 'descartados': a['descartados']}


# ------------------------------------------------------------------ descarga a Excel (.xlsx)
def _col(n):
    s = ''
    n += 1
    while n:
        n, r = divmod(n - 1, 26)
        s = chr(65 + r) + s
    return s


def escribir_xlsx(hojas):
    """hojas = [{'nombre', 'celdas': {(fila, col): valor}, 'negritas': set, 'anchos': {col: ancho}, 'congelar': bool}]
    fila y col empiezan en 0. valor puede ser texto, número, fecha o ('=', 'SUM(C4:C8)'). Regresa bytes de un .xlsx."""
    def celda(ref, v, negrita):
        st = 1 if negrita else 0
        if v is None or v == '':
            return '<c r="%s" s="%d"/>' % (ref, st) if negrita else ''
        if isinstance(v, tuple) and v and v[0] == '=':
            return '<c r="%s" s="%d"><f>%s</f></c>' % (ref, st, escape(v[1]))
        if isinstance(v, (dt.date, dt.datetime)):
            dias = ((v.date() if isinstance(v, dt.datetime) else v) - dt.date(1899, 12, 30)).days
            return '<c r="%s" s="%d"><v>%d</v></c>' % (ref, 3 if negrita else 2, dias)
        if isinstance(v, bool):
            v = 'Sí' if v else 'No'
        if isinstance(v, (int, float)):
            return '<c r="%s" s="%d"><v>%s</v></c>' % (ref, st, repr(float(v)) if isinstance(v, float) else v)
        return '<c r="%s" t="inlineStr" s="%d"><is><t xml:space="preserve">%s</t></is></c>' % (ref, st, escape(str(v)))

    buf = io.BytesIO()
    z = zipfile.ZipFile(buf, 'w', zipfile.ZIP_DEFLATED)
    n = len(hojas)
    z.writestr('[Content_Types].xml', '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
               '<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">'
               '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>'
               '<Default Extension="xml" ContentType="application/xml"/>'
               '<Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/>'
               '<Override PartName="/xl/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml"/>'
               + ''.join('<Override PartName="/xl/worksheets/sheet%d.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>' % (i + 1)
                         for i in range(n)) + '</Types>')
    z.writestr('_rels/.rels', '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
               '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
               '<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/>'
               '</Relationships>')
    z.writestr('xl/workbook.xml', '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
               '<workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" '
               'xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><sheets>'
               + ''.join('<sheet name="%s" sheetId="%d" r:id="rId%d"/>' % (escape(h['nombre'][:31]), i + 1, i + 1) for i, h in enumerate(hojas))
               + '</sheets><calcPr calcId="191029" fullCalcOnLoad="1"/></workbook>')
    z.writestr('xl/_rels/workbook.xml.rels', '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
               '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
               + ''.join('<Relationship Id="rId%d" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet%d.xml"/>' % (i + 1, i + 1)
                         for i in range(n))
               + '<Relationship Id="rId%d" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles" Target="styles.xml"/>' % (n + 1)
               + '</Relationships>')
    z.writestr('xl/styles.xml', '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
               '<styleSheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">'
               '<numFmts count="1"><numFmt numFmtId="164" formatCode="d-mmm-yy"/></numFmts>'
               '<fonts count="2"><font><sz val="11"/><name val="Calibri"/></font><font><b/><sz val="11"/><name val="Calibri"/></font></fonts>'
               '<fills count="2"><fill><patternFill patternType="none"/></fill><fill><patternFill patternType="gray125"/></fill></fills>'
               '<borders count="1"><border><left/><right/><top/><bottom/><diagonal/></border></borders>'
               '<cellStyleXfs count="1"><xf numFmtId="0" fontId="0" fillId="0" borderId="0"/></cellStyleXfs>'
               '<cellXfs count="4"><xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0"/>'
               '<xf numFmtId="0" fontId="1" fillId="0" borderId="0" xfId="0" applyFont="1"/>'
               '<xf numFmtId="164" fontId="0" fillId="0" borderId="0" xfId="0" applyNumberFormat="1"/>'
               '<xf numFmtId="164" fontId="1" fillId="0" borderId="0" xfId="0" applyNumberFormat="1" applyFont="1"/></cellXfs>'
               '<cellStyles count="1"><cellStyle name="Normal" xfId="0" builtinId="0"/></cellStyles>'
               '</styleSheet>')
    for i, h in enumerate(hojas):
        celdas, negritas = h['celdas'], h.get('negritas', set())
        filas = {}
        for (r, c), v in celdas.items():
            filas.setdefault(r, {})[c] = v
        for (r, c) in negritas:
            filas.setdefault(r, {}).setdefault(c, '')
        xml_filas = []
        for r in sorted(filas):
            xml_filas.append('<row r="%d">' % (r + 1) + ''.join(
                celda('%s%d' % (_col(c), r + 1), filas[r][c], (r, c) in negritas) for c in sorted(filas[r])) + '</row>')
        anchos = h.get('anchos', {})
        cols = ''.join('<col min="%d" max="%d" width="%d" customWidth="1"/>' % (c + 1, c + 1, w) for c, w in sorted(anchos.items()))
        vista = ('<sheetViews><sheetView workbookViewId="0"><pane ySplit="1" topLeftCell="A2" activePane="bottomLeft" state="frozen"/></sheetView></sheetViews>'
                 if h.get('congelar') else '')
        z.writestr('xl/worksheets/sheet%d.xml' % (i + 1), '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
                   '<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">' + vista
                   + ('<cols>' + cols + '</cols>' if cols else '') + '<sheetData>' + ''.join(xml_filas) + '</sheetData></worksheet>')
    z.close()
    return buf.getvalue()


def hoja_tabla(nombre, encabezados, filas):
    celdas = {(0, c): h for c, h in enumerate(encabezados)}
    for r, f in enumerate(filas, start=1):
        for c, v in enumerate(f):
            celdas[(r, c)] = v
    anchos = {c: min(45, max(8, max([len(str(h))] + [len(str(f[c])) for f in filas if c < len(f) and f[c] is not None]) + 2))
              for c, h in enumerate(encabezados)}
    return {'nombre': nombre, 'celdas': celdas, 'negritas': {(0, c) for c in range(len(encabezados))}, 'anchos': anchos, 'congelar': True}


def hacer_xlsx(hojas):
    return escribir_xlsx([hoja_tabla(*h) for h in hojas])


def datos_vivos():
    estado, _, _, _ = estado_actual()
    db = {k: [r for r in estado['db'].get(k, []) if not r.get('del')] for k in COLS}
    return estado['conf'], db


def total_v(v):
    return round(sum(i['precio'] for i in v['items']) - (v.get('desc') or 0), 2)


def pagos_por_venta(db):
    m = {}
    for p in db['pagos']:
        if p.get('venta'):
            m.setdefault(p['venta'], []).append(p)
    return m


def precios_netos(v):
    d = v.get('desc') or 0
    out = []
    for p in reversed([i['precio'] for i in v['items']]):
        q = min(p, d)
        d -= q
        out.append(round(p - q, 2))
    return list(reversed(out))


def etiqueta_semana(fechas):
    meses = ['ENERO', 'FEBRERO', 'MARZO', 'ABRIL', 'MAYO', 'JUNIO', 'JULIO', 'AGOSTO', 'SEPTIEMBRE', 'OCTUBRE', 'NOVIEMBRE', 'DICIEMBRE']
    a, b = min(fechas), max(fechas)
    if a == b:
        return '%s %d' % (meses[a.month - 1], a.day)
    if a.month == b.month:
        return '%s %d-%d' % (meses[a.month - 1], a.day, b.day)
    return '%s %d-%s %d' % (meses[a.month - 1], a.day, meses[b.month - 1], b.day)


def perritos_por_semana(perros, tipo):
    semanas = {}
    for p in perros:
        if (p.get('tipo') or 'Baño') != tipo:
            continue
        f = dt.date.fromisoformat(p['fecha'])
        lunes = f - dt.timedelta(days=f.weekday())
        semanas.setdefault(lunes, []).append((f, p['monto']))
    return [(etiqueta_semana([f for f, _ in v]), round(sum(m for _, m in v), 2)) for _, v in sorted(semanas.items())]


CORRIDA_INICIAL = {'id': 'R-inicial', 'nombre': '4ta corrida', 'inicio': '2000-01-01', 'cre': 1}


def lista_corridas(db):
    l = list(db.get('corridas', []))
    if not any(c['id'] == 'R-inicial' for c in l):
        l.append(dict(CORRIDA_INICIAL))
    return sorted(l, key=lambda c: (c.get('inicio', ''), c.get('cre') or 0))


def corrida_de(r):
    return r.get('corrida') or 'R-inicial'


def es_produccion(m):
    return bool(re.match(r'^Producción', m.get('motivo') or '')) and m.get('cambio', 0) > 0


def produccion_corrida(db, aromas, cid):
    ms = [m for m in db['movs'] if corrida_de(m) == cid and es_produccion(m)]
    return [(a, sum(m['cambio'] for m in ms if m['aroma'] == a and m['tam'] == 'G'),
             sum(m['cambio'] for m in ms if m['aroma'] == a and m['tam'] == 'CH')) for a in aromas]


def libro_formato():
    """Un .xlsx con el MISMO acomodo de las hojas de M_M_Home_Fragance.xlsx, para copiar bloques completos."""
    conf, db = datos_vivos()
    precios = conf.get('precios') or {'CH': 100, 'G': 180}
    pagos_de = pagos_por_venta(db)
    aromas = conf.get('aromas', [])

    # --- hoja 1: igual que VENTA DE FRAGANCIAS (inventario único: no importa de qué corrida salió cada bote)
    entregadas = [v for v in db['ventas'] if v.get('entregado')]
    corr = lista_corridas(db)
    c, neg = {}, set()

    def poner(r, col, v, b=False):
        c[(r, col)] = v
        if b:
            neg.add((r, col))
    poner(1, 1, 'INVENTARIO (APP) · corrida actual: ' + corr[-1]['nombre'].upper(), True)
    for col, h in enumerate(['AROMA', 'G', 'CH', 'VENDIDOS G', 'VENDIDOS CH', 'QUEDAN G', 'QUEDAN CH'], start=1):
        poner(2, col, h, True)

    def vendidos(a, t):
        return sum(1 for v in entregadas for it in v['items'] if it['aroma'] == a and it['tam'] == t)

    def exist(a, t):
        base = sum(m['cambio'] for m in db['movs'] if m['aroma'] == a and m['tam'] == t)
        mu = sum(1 for m in db['muestras'] if m['aroma'] == a and m['tam'] == t and m.get('estado') in ('prestada', 'regalada'))
        return base - vendidos(a, t) - mu
    r = 3
    for a in aromas:
        x = r + 1
        poner(r, 1, a.upper())
        poner(r, 2, exist(a, 'G') + vendidos(a, 'G'))
        poner(r, 3, exist(a, 'CH') + vendidos(a, 'CH'))
        poner(r, 4, vendidos(a, 'G'))
        poner(r, 5, vendidos(a, 'CH'))
        poner(r, 6, ('=', 'C%d-E%d' % (x, x)))
        poner(r, 7, ('=', 'D%d-F%d' % (x, x)))
        r += 1
    fin_inv = r
    poner(r, 1, 'CANTIDADES TOTALES', True)
    for col in (2, 3, 4, 5, 6, 7):
        L = _col(col)
        poner(r, col, ('=', 'SUM(%s4:%s%d)' % (L, L, fin_inv)), True)
    r += 1
    poner(r, 1, 'TOTALES $', True)
    poner(r, 2, ('=', 'C%d*%s' % (fin_inv + 1, precios['G'])))
    poner(r, 3, ('=', 'D%d*%s' % (fin_inv + 1, precios['CH'])))
    r += 3
    ini_v = r
    for col, h in enumerate(['VENTAS', 'AROMA', 'COSTO', 'PAGADO', 'NO PAGADO', 'MÉTODO'], start=1):
        poner(r, col, h, True)
    poner(ini_v - 1, 9, 'PEDIDOS', True)
    r += 1
    for v in entregadas:
        pagos = pagos_de.get(v['id'], [])
        disp = sum(p['monto'] for p in pagos)
        metodo = '/'.join(sorted({p['metodo'] for p in pagos}))
        for it, precio in zip(v['items'], precios_netos(v)):
            pag = min(precio, disp)
            disp -= pag
            poner(r, 1, v['cliente'])
            poner(r, 2, it['aroma'].upper())
            poner(r, 3, precio)
            poner(r, 4, pag if pag else None)
            poner(r, 5, round(precio - pag, 2) if precio - pag else None)
            poner(r, 6, metodo if pag else None)
            r += 1
    poner(r, 2, 'TOTALES', True)
    for col in (3, 4, 5):
        L = _col(col)
        poner(r, col, ('=', 'SUM(%s%d:%s%d)' % (L, ini_v + 2, L, max(r, ini_v + 2))), True)
    rp = ini_v
    for v in db['ventas']:
        if v.get('pedido') and not v.get('entregado'):
            for it, precio in zip(v['items'], precios_netos(v)):
                poner(rp, 9, v['cliente'])
                poner(rp, 10, it['aroma'].upper())
                poner(rp, 11, it['tam'])
                poner(rp, 12, precio)
                poner(rp, 13, 'ENTREGA ' + (v.get('entrega') or ''))
                rp += 1
    hoja1 = {'nombre': 'VENTA DE FRAGANCIAS (APP)', 'celdas': c, 'negritas': neg,
             'anchos': {1: 24, 2: 22, 3: 10, 4: 11, 5: 12, 6: 14, 7: 11, 9: 18, 10: 22, 11: 8, 12: 9, 13: 18}}

    # --- corridas: solo la producción de cada tanda (TOTAL FABRICADOS)
    c, neg = {}, set()
    r = 1
    for cr in reversed(corr):
        filas = [f for f in produccion_corrida(db, aromas, cr['id']) if f[1] or f[2]]
        if not filas:
            continue
        fecha = cr.get('inicio', '')
        poner(r, 1, 'TOTAL FABRICADOS ' + cr['nombre'].upper() + ('  (' + fecha + ')' if fecha > '2001' else ''), True)
        r += 1
        for col, h in enumerate(['AROMA', 'G', 'CH'], start=1):
            poner(r, col, h, True)
        r += 1
        ini = r
        for a, g, ch in filas:
            poner(r, 1, a.upper()); poner(r, 2, g); poner(r, 3, ch)
            r += 1
        poner(r, 1, 'CANTIDADES TOTALES', True)
        poner(r, 2, ('=', 'SUM(C%d:C%d)' % (ini + 1, r)), True)
        poner(r, 3, ('=', 'SUM(D%d:D%d)' % (ini + 1, r)), True)
        r += 3
    hoja_corr = {'nombre': 'CORRIDAS (APP)', 'celdas': c, 'negritas': neg, 'anchos': {1: 40, 2: 8, 3: 8}}

    # --- hoja 2: igual que VENTAS AMBOS NEGOCIOS
    c, neg = {}, set()

    def poner(r, col, v, b=False):
        c[(r, col)] = v
        if b:
            neg.add((r, col))
    perros = db['perros']
    deben = round(sum(max(0, total_v(v) - sum(p['monto'] for p in pagos_de.get(v['id'], []))) for v in db['ventas']), 2)
    ef = sum(p['monto'] for p in db['pagos'] if p['metodo'] == 'EFECTIVO') + sum(p['monto'] for p in perros if p['metodo'] == 'EFECTIVO') \
        - sum(g['monto'] for g in db['gastos'] if g['metodo'] == 'EFECTIVO')
    trans = sorted([(p['fecha'], p.get('hora', ''), p['monto'], 'AROMAS ' + p['cliente']) for p in db['pagos'] if p['metodo'] == 'TRANSFERENCIA']
                   + [(p['fecha'], p.get('hora', ''), p['monto'], 'PERRITOS ' + (p.get('nota') or '').upper()) for p in perros if p['metodo'] == 'TRANSFERENCIA']
                   + [(g['fecha'], g.get('hora', ''), -g['monto'], 'GASTO ' + (g.get('nota') or '')) for g in db['gastos'] if g['metodo'] == 'TRANSFERENCIA'])
    poner(1, 1, 'TOTAL VENDIDO AROMAS (APP)', True); poner(1, 5, round(sum(total_v(v) for v in db['ventas']), 2))
    poner(2, 1, 'TOTAL PERRITOS (APP)', True); poner(2, 5, round(sum(p['monto'] for p in perros), 2))
    poner(3, 1, 'TOTAL AMBOS NEGOCIOS', True); poner(3, 5, ('=', 'F2+F3'))
    poner(4, 1, 'TOTAL FALTA DE PAGOS', True); poner(4, 5, deben)
    poner(5, 1, 'TOTAL COMPLETO', True); poner(5, 5, ('=', 'F4-F5'))
    poner(6, 1, 'A FAVOR', True); poner(6, 5, ('=', 'F15-F6'))
    poner(13, 1, 'TRANSFERENCIAS', True); poner(13, 4, 'TENGO EN EFECTIVO', True); poner(13, 5, 'TOTAL', True)
    r = 14
    for f, _, m, nota in trans:
        poner(r, 1, dt.date.fromisoformat(f))
        poner(r, 2, m)
        poner(r, 3, nota)
        r += 1
    poner(r, 1, 'TOTAL', True)
    poner(r, 2, ('=', 'SUM(C15:C%d)' % r), True)
    poner(14, 4, round(ef, 2))
    poner(14, 5, ('=', 'C%d+E15' % (r + 1)))
    hoja2 = {'nombre': 'VENTAS AMBOS NEGOCIOS (APP)', 'celdas': c, 'negritas': neg, 'anchos': {1: 30, 2: 12, 3: 28, 4: 20, 5: 14}}

    # --- hoja 3: igual que VENTA BAÑO DE PERRITOS
    c, neg = {}, set()

    def poner(r, col, v, b=False):
        c[(r, col)] = v
        if b:
            neg.add((r, col))
    poner(1, 5, 'BAÑO DE MASCOTAS', True); poner(1, 8, 'PASEO DE MASCOTAS', True)
    poner(2, 5, 'SEMANA', True); poner(2, 6, 'GANANCIA', True); poner(2, 8, 'SEMANA', True); poner(2, 9, 'GANANCIA', True)
    banos, paseos = perritos_por_semana(perros, 'Baño'), perritos_por_semana(perros, 'Paseo')
    for k, (et, m) in enumerate(banos):
        poner(3 + k, 5, et); poner(3 + k, 6, m)
    for k, (et, m) in enumerate(paseos):
        poner(3 + k, 8, et); poner(3 + k, 9, m)
    fin = 3 + max(len(banos), len(paseos), 1)
    poner(fin, 5, 'TOTAL:', True); poner(fin, 6, ('=', 'SUM(G4:G%d)' % fin), True)
    poner(fin, 8, 'TOTAL:', True); poner(fin, 9, ('=', 'SUM(J4:J%d)' % fin), True)
    otros = [p for p in perros if (p.get('tipo') or 'Baño') not in ('Baño', 'Paseo')]
    if otros:
        poner(fin + 2, 5, 'OTROS (sin tipo)', True); poner(fin + 2, 6, round(sum(p['monto'] for p in otros), 2))
    hoja3 = {'nombre': 'VENTA BAÑO DE PERRITOS (APP)', 'celdas': c, 'negritas': neg, 'anchos': {5: 26, 6: 12, 8: 26, 9: 12}}
    return escribir_xlsx([hoja1, hoja2, hoja3] + ([hoja_corr] if hoja_corr['celdas'] else []))


