class Manejador(BaseHTTPRequestHandler):

    def log_message(self, *args):
        pass

    def _enviar(self, codigo, cuerpo, tipo):
        if isinstance(cuerpo, str):
            cuerpo = cuerpo.encode('utf-8')
        self.send_response(codigo)
        self.send_header('Content-Type', tipo)
        self.send_header('Content-Length', str(len(cuerpo)))
        self.send_header('Cache-Control', 'no-store')
        self.end_headers()
        self.wfile.write(cuerpo)

    def _json(self, obj, codigo=200):
        self._enviar(codigo, json.dumps(obj, ensure_ascii=False), 'application/json; charset=utf-8')

    def do_GET(self):
        try:
            self._get()
        except Exception as e:
            if isinstance(e, (BrokenPipeError, ConnectionResetError, ConnectionAbortedError)):
                return                 # Safari dejó de esperar (Pythonista estaba dormido): no es un error
            anotar_error('GET ' + self.path, repr(e))
            try:
                self._json({'ok': False, 'error': repr(e)}, 500)
            except Exception:
                pass

    def do_POST(self):
        try:
            self._post()
        except Exception as e:
            if isinstance(e, (BrokenPipeError, ConnectionResetError, ConnectionAbortedError)):
                return                 # Safari dejó de esperar (Pythonista estaba dormido): no es un error
            anotar_error('POST ' + self.path, repr(e))
            try:
                self._json({'ok': False, 'error': repr(e)}, 500)
            except Exception:
                pass

    def _get(self):
        ruta = self.path.split('?')[0]
        if ruta in ('/', '/index.html'):
            self._enviar(200, PAGINA, 'text/html; charset=utf-8')
        elif ruta == '/sw.js':
            self._enviar(200, SW, 'application/javascript; charset=utf-8')
        elif ruta == '/api/datos':
            with CANDADO:
                self._json(respuesta())
        elif ruta == '/api/ping':
            self._json({'ok': True, 'version': VERSION})
        elif ruta == '/api/intercambio/lista':
            with CANDADO:
                self._json(archivos_intercambio())
        elif ruta == '/api/intercambio/descargar':
            q = urllib.parse.parse_qs(self.path.split('?', 1)[1] if '?' in self.path else '')
            p = buscar_export((q.get('archivo') or [''])[0])
            with open(p, 'rb') as f:
                datos = f.read()
            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.send_header('Content-Disposition', 'attachment; filename="%s"' % os.path.basename(p))
            self.send_header('Content-Length', str(len(datos)))
            self.end_headers()
            self.wfile.write(datos)
        elif ruta == '/api/respaldos':
            self._json({'respaldos': listar_respaldos()})
        elif ruta in ('/api/exportar', '/api/exportar_formato'):
            formato = ruta.endswith('formato')
            with CANDADO:
                datos = libro_formato() if formato else libro_completo()
            nombre = 'GG_Caja_%s%s.xlsx' % ('formato_' if formato else '', dt.date.today().isoformat())
            self.send_response(200)
            self.send_header('Content-Type', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet')
            self.send_header('Content-Disposition', 'attachment; filename="%s"' % nombre)
            self.send_header('Content-Length', str(len(datos)))
            self.end_headers()
            self.wfile.write(datos)
        else:
            self._enviar(404, 'No encontrado', 'text/plain; charset=utf-8')

    def _cuerpo(self):
        n = int(self.headers.get('Content-Length', 0))
        return json.loads(self.rfile.read(n).decode('utf-8')) if n else {}

    def _post(self):
        ruta = self.path.split('?')[0]
        if ruta.startswith('/api/intercambio/'):
            try:
                cuerpo = self._cuerpo()
                with CANDADO:
                    if ruta.endswith('/exportar'):
                        self._json(exportar_datos())
                    elif ruta.endswith('/revisar'):
                        if cuerpo.get('contenido'):
                            inc, nombre = guardar_recibido(cuerpo['contenido'], cuerpo.get('nombre', ''))
                        else:
                            nombre = os.path.basename(cuerpo.get('archivo', ''))
                            inc = leer_export(leer_json(buscar_export(nombre)))
                        estado, _, _, _ = estado_actual()
                        b = cuerpo.get('borrar')
                        a = analizar(estado, inc, None, None if b is None else bool(b))
                        a['archivo'] = nombre
                        self._json(a)
                    elif ruta.endswith('/aplicar'):
                        b = cuerpo.get('borrar')
                        res = importar(cuerpo.get('archivo', ''), cuerpo.get('decisiones') or {}, None if b is None else bool(b),
                                       cuerpo.get('dinero'))
                        d = respuesta()
                        d['resultado'] = res
                        self._json(d)
                    else:
                        self._enviar(404, 'No encontrado', 'text/plain; charset=utf-8')
            except ValueError as e:
                self._json({'ok': False, 'error': str(e)}, 400)
            return
        if self.path.split('?')[0] == '/api/restaurar':
            n = int(self.headers.get('Content-Length', 0))
            archivo = json.loads(self.rfile.read(n).decode('utf-8')).get('archivo', '')
            with CANDADO:
                restaurar(archivo)
                self._json(respuesta())
            return
        if self.path.split('?')[0] == '/api/apagar':
            self._json({'ok': True})
            threading.Thread(target=apagar, daemon=True).start()
            return
        if self.path.split('?')[0] != '/api/datos':
            self._enviar(404, 'No encontrado', 'text/plain; charset=utf-8')
            return
        try:
            n = int(self.headers.get('Content-Length', 0))
            data = json.loads(self.rfile.read(n).decode('utf-8'))
            if not isinstance(data.get('db'), dict):
                raise ValueError('datos incompletos')
        except Exception as e:
            anotar_error('POST datos inválidos', repr(e))
            self._json({'ok': False, 'error': str(e)}, 400)
            return
        with CANDADO:
            quien = ((data.get('conf') or {}).get('quien') or '').strip()
            yo = este_celular()
            if quien and quien != yo.get('quien'):
                yo['quien'] = quien
                escribir_json(F_LOCAL, yo)
            estado, _, _, _ = estado_actual()
            guardar_propio(mezclar(estado, data))
            self._json(respuesta())


def servidor_ya_corre():
    try:
        socket.create_connection(('127.0.0.1', PUERTO), timeout=0.5).close()
        return True
    except OSError:
        return False


def apagar():
    """Apaga el servidor (los datos ya quedaron guardados en cada POST)."""
    time.sleep(0.3)
    if SERVIDOR is not None:
        SERVIDOR.shutdown()
        SERVIDOR.server_close()
    print('GG Caja guardada y apagada.')


def version_corriendo():
    """Versión de la caja que ya está prendida en este celular (None si no hay)."""
    try:
        return json.loads(urllib.request.urlopen(URL + 'api/ping', timeout=1.5).read().decode('utf-8')).get('version')
    except Exception:
        return None


def apagar_anterior():
    """Si quedó una caja prendida de antes, le pide que se apague. True si el puerto quedó libre."""
    if not servidor_ya_corre():
        return True
    try:
        req = urllib.request.Request(URL + 'api/apagar', data=b'{}', method='POST',
                                     headers={'Content-Type': 'application/json'})
        urllib.request.urlopen(req, timeout=2).read()
    except Exception:
        pass
    for _ in range(80):
        if not servidor_ya_corre():
            return True
        time.sleep(0.1)
    return False


