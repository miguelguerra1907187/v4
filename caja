        concepto = ('Venta del %s' % v['fecha']) if v else ('Pago suelto' + (': ' + p['nota'] if p.get('nota') else ''))
        f_pagos.append([p['fecha'], p.get('hora', ''), p['cliente'], p['monto'], p['metodo'], concepto, p.get('quien', '')])
    f_perros = [[p['fecha'], p.get('hora', ''), p.get('tipo') or 'Baño', p['monto'], p['metodo'], p.get('nota', ''), p.get('quien', '')] for p in db['perros']]
    f_gastos = [[g['fecha'], g.get('hora', ''), 'Perritos' if g.get('negocio') == 'pe' else 'Aromas', g['monto'], g['metodo'], g.get('nota', ''), g.get('quien', '')] for g in db['gastos']]

    def exist(a, t):
        base = sum(m['cambio'] for m in db['movs'] if m['aroma'] == a and m['tam'] == t)
        sal = sum(1 for v in db['ventas'] if v.get('entregado') for i in v['items'] if i['aroma'] == a and i['tam'] == t)
        mu = sum(1 for m in db['muestras'] if m['aroma'] == a and m['tam'] == t and m.get('estado') in ('prestada', 'regalada'))
        return base - sal - mu

    def apart(a, t):
        return sum(1 for v in db['ventas'] if v.get('pedido') and not v.get('entregado') for i in v['items'] if i['aroma'] == a and i['tam'] == t)
    f_inv = [[a, exist(a, 'CH'), apart(a, 'CH'), exist(a, 'G'), apart(a, 'G')] for a in conf.get('aromas', [])]
    f_cortes = [[c['fecha'], c.get('hora', ''), c.get('quien', ''), c.get('periodo', ''), c.get('esperado', 0), c.get('contado', 0),
                 c.get('dif', 0), c.get('transferencias', 0)] for c in db['cortes']]
    estados = {'prestada': 'Prestada', 'regreso': 'Regresó', 'vendida': 'La compró', 'regalada': 'Regalada'}
    f_muestras = [[m['fecha'], m['aroma'], m['tam'], m.get('persona', ''), estados.get(m.get('estado'), m.get('estado')), m.get('fin', ''),
                   m.get('nota', ''), m.get('quien', '')] for m in db['muestras']]
    deuda = {}
    for v in db['ventas']:
        d = round(total(v) - pagado(v), 2)
        if d > 0:
            deuda[v['cliente']] = deuda.get(v['cliente'], 0) + d
    tels = {c['nombre']: c.get('tel', '') for c in db['clientes']}
    f_clientes = [[n, tels.get(n, ''), round(deuda.get(n, 0), 2)] for n in sorted(set(list(tels) + [v['cliente'] for v in db['ventas']]))]
    return hacer_xlsx([
        ('Ventas', ['Fecha', 'Hora', 'Cliente', 'Aroma', 'Tamaño', 'Precio', 'Descuento venta', 'Total venta', 'Pagado venta',
                    'Debe venta', 'Tipo', 'Entrega', 'Entregado', 'Nota', 'Anotó', 'ID venta'], f_ventas),
        ('Pagos', ['Fecha', 'Hora', 'Cliente', 'Monto', 'Método', 'Concepto', 'Anotó'], f_pagos),
        ('Perritos', ['Fecha', 'Hora', 'Tipo', 'Monto', 'Método', 'Nota', 'Anotó'], f_perros),
        ('Gastos', ['Fecha', 'Hora', 'Negocio', 'Monto', 'Método', 'Concepto', 'Anotó'], f_gastos),
        ('Inventario', ['Aroma', 'CH en existencia', 'CH apartados', 'G en existencia', 'G apartados'], f_inv),
        ('Cortes', ['Fecha', 'Hora', 'Quién', 'Periodo', 'Debía haber', 'Contado', 'Diferencia', 'Transferencias'], f_cortes),
        ('Muestras', ['Fecha', 'Aroma', 'Tamaño', 'Prestada a', 'Estado', 'Fecha fin', 'Nota', 'Anotó'], f_muestras),
        ('Clientes', ['Cliente', 'WhatsApp', 'Debe'], f_clientes),
