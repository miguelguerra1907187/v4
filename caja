def extras_respuesta():
    """Lo nuevo que se manda a Safari. Si algo falla aquí, NUNCA debe tumbar la sincronización."""
    out = {}
    for k, f in (('yo', lambda: este_celular()['id']), ('intercambio', resumen_intercambio), ('lanzar', url_lanzar)):
