function enDias(n, base) { const d = base ? deIso(base) : new Date(); d.setDate(d.getDate() + n); return isoDe(d); }
function hora() { const d = new Date(); return pad(d.getHours()) + ':' + pad(d.getMinutes()); }
function corta(iso) { if (!iso) return ''; const p = iso.split('-').map(Number); return p[2] + ' ' + MESES[p[1] - 1]; }
function larga(iso) { const d = deIso(iso); return DIAS[d.getDay()] + ' ' + d.getDate() + ' ' + MESES[d.getMonth()]; }
function dmy(iso) { const p = iso.split('-'); return p[2] + '/' + p[1] + '/' + p[0]; }
function r2(x) { return Math.round(x * 100) / 100; }
function dinero(x) {
  x = r2(Number(x) || 0);
