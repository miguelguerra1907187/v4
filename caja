// Resumen de cada día en una sola pasada (mismas cuentas que el corte: pagos + perritos − gastos)
function resumenDias() {
  const D = {};
  const dia = f => D[f] || (D[f] = {f: f, vendido: 0, ch: 0, g: 0, nVentas: 0, ef: 0, tr: 0, cortes: []});
  const dinero_ = (x, r, signo) => { if (r.metodo === EFE) x.ef += signo * r.monto; else if (r.metodo === TRA) x.tr += signo * r.monto; };
  S.v.ventas.forEach(v => {
    if (!v.fecha) return;
    const x = dia(v.fecha); x.vendido += totalVenta(v); x.nVentas++;
    v.items.forEach(i => { if (i.tam === 'CH') x.ch++; else if (i.tam === 'G') x.g++; });
  });
  S.v.pagos.forEach(p => { if (p.fecha) dinero_(dia(p.fecha), p, 1); });
  S.v.perros.forEach(p => { if (p.fecha) dinero_(dia(p.fecha), p, 1); });
  S.v.gastos.forEach(g => { if (g.fecha) dinero_(dia(g.fecha), g, -1); });
  S.v.cortes.forEach(c => { if (c.fecha) dia(c.fecha).cortes.push(c); });
  Object.values(D).forEach(x => x.cortes.sort((a, b) => (a.cre || 0) - (b.cre || 0) || (a.hora || '').localeCompare(b.hora || '')));
  return Object.values(D).sort((a, b) => b.f.localeCompare(a.f));
}
let CF = {modo: 0, n: 45};
P.cortes = () => {
  F = {modo: CF.modo};
  alCambiar = k => { if (k === 'modo') { CF.modo = F.modo; CF.n = 45; refrescar(); } };
  const todos = resumenDias();
  const semanas = {};
  todos.forEach(x => {
    const s = semanas[lunesDe(x.f)] || (semanas[lunesDe(x.f)] = {ef: 0, tr: 0, ch: 0, g: 0});
    s.ef += x.ef; s.tr += x.tr; s.ch += x.ch; s.g += x.g;
  });
  const dias = CF.modo === 1 ? todos.filter(x => x.cortes.length) : todos;
