function diaLargo(iso) { return DIAS[deIso(iso).getDay()] + ' ' + corta(iso); }
function lunesDe(iso) { const d = deIso(iso); d.setDate(d.getDate() - ((d.getDay() + 6) % 7)); return isoDe(d); }
function etiquetaCorte(c) {
