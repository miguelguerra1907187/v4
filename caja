PATRON_EXPORT_NUBE = re.compile(r'^\.(GG_Caja_.*\.json)\.icloud$', re.I)
ICLOUD_PY = '/private/var/mobile/Library/Mobile Documents/iCloud~com~omz-software~Pythonista3/Documents'
