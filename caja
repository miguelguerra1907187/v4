async function aplicarImportacion(p, el, desdePendiente) {
  const datos = {archivo: p.archivo, decisiones: p.decisiones || {}, borrar: p.borrar, dinero: p.dinero};
  const listo = () => { if (el) { el.disabled = false; el.textContent = '📥 Importar'; } };
  const dormido = () => {
    listo();
    if (!desdePendiente) { despertarPara(Object.assign({accion: 'aplicar'}, datos)); return; }
    try { localStorage.setItem(LS_PEND, JSON.stringify(Object.assign({accion: 'aplicar', t: Date.now()}, datos))); } catch (e) {}
    abrirModal('<h2>Pythonista no contestó</h2><p class="sub">No se importó nada todavía. Toca ◀ Pythonista arriba a la izquierda (o abre tu atajo de la caja), espera un segundo y regresa a Safari: se termina solo.</p>' +
      '<button class="btn gris" data-act="cerrar">Cerrar</button>');
  };
  if (el) { el.disabled = true; el.textContent = 'Importando...'; }
  if (!(await pythonistaVivo())) { dormido(); return; }
  if (!(await subirTodo())) { dormido(); return; }
  let r;
  try {
    r = await pedir('/api/intercambio/aplicar', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(datos)}, 30000);
  } catch (e) { dormido(); return; }
  let x;
  try {
    x = await r.json();
    if (!r.ok) throw new Error(x.error || 'http ' + r.status);
  } catch (e) {
    listo();
    registrarError('importar', e);
    abrirModal('<h2>No se pudo importar</h2><p class="sub">' + esc(e.message || e) + '</p><p class="ayuda">No se cambió nada. Toma captura y mándasela a Miguel.</p>' +
      '<button class="btn gris" data-act="cerrar">Cerrar</button>');
    return;
  }
  aplicarRemoto(x);
  IMPORT = null;
  refrescar();
  abrirModal('<h2>✅ Datos importados</h2><p class="sub">' + esc(x.resultado.texto) + '</p>' +
    '<p class="ayuda">Si algo no te cuadra: Ajustes › Restaurar un respaldo › "Antes de importar datos".</p>' +
    '<button class="btn" data-act="cerrarMenu">Ir al menú</button><button class="btn gris" data-act="cerrar">Cerrar</button>');
}
async function crearArchivo(el) {
  const txt = el ? el.textContent : '';
  if (el) { el.disabled = true; el.textContent = 'Creando archivo...'; }
  const listo = () => { if (el) { el.disabled = false; el.textContent = txt; } };
  if (!(await pythonistaVivo())) { listo(); despertarPara({accion: 'exportar'}); return; }
  await subirTodo();
  let ex = null, error = '';
  try {
    const r = await pedir('/api/intercambio/exportar', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: '{}'}, 20000);
    ex = await r.json();
    if (!r.ok) { error = ex.error || 'http ' + r.status; ex = null; }
    else if (ex.intercambio) INFO.intercambio = ex.intercambio;
  } catch (e) { ex = null; }
  listo();
  if (error) {
    registrarError('crear archivo', error);
