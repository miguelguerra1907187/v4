def ruta_bonita(p):
    """La ruta como se ve en la app Archivos del iPhone."""
    p = os.path.realpath(p)
    for raiz, nombre in ((os.path.realpath(DOCS), 'En mi iPhone › Pythonista 3'),
                         (os.path.realpath(ICLOUD_PY), 'iCloud Drive › Pythonista 3')):
        if p == raiz or p.startswith(raiz + os.sep):
            rel = os.path.relpath(p, raiz)
            return nombre + ('' if rel == '.' else ' › ' + rel.replace(os.sep, ' › '))
    return ' › '.join([x for x in p.split(os.sep) if x][-3:])


def dirs_intercambio():
    """Dónde se buscan archivos: primero la carpeta estándar, luego junto a MM_Caja.py."""
    ruta, _ = carpeta()
    vistos, out = set(), []
    for c in (os.path.join(ruta, INTERCAMBIO), ruta, os.path.join(BASE, INTERCAMBIO), BASE, os.path.join(DOCS, INTERCAMBIO), DOCS):
        r = os.path.realpath(c)
        if r not in vistos and os.path.isdir(c):
            vistos.add(r)
            out.append(c)
    return out


