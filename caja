// existencia = movimientos (conteos, producción, ajustes) − botes ya entregados
function existencia(a, t) {
  const base = S.v.movs.filter(m => m.aroma === a && m.tam === t).reduce((s, m) => s + m.cambio, 0);
  const salieron = S.v.ventas.filter(v => v.entregado).reduce((s, v) => s + v.items.filter(i => i.aroma === a && i.tam === t).length, 0);
  const muestras = S.v.muestras.filter(m => m.aroma === a && m.tam === t && (m.estado === 'prestada' || m.estado === 'regalada')).length;
  return base - salieron - muestras;
}
function apartado(a, t) {
